# Python caches and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# OS/editor files
.DS_Store
.vscode/
.idea/
*.swp

# Secrets and local config
.env
.env.*
*.key
*.pem
*api_key*
secrets.*
local_config.*

# Logs and runtime outputs
*.log
logs/

# Raw / large data should be regenerated or downloaded locally
data/raw/*
!data/raw/.gitkeep

# Ignore processed data by default, then allow the small final demo artifacts
/data/processed/*
!data/processed/.gitkeep
!data/processed/activation_features_train_512.npz
!data/processed/activation_features_train_512.metadata.json
!data/processed/activation_features_validation_128.npz
!data/processed/activation_features_validation_128.metadata.json
!data/processed/routing_table_train_512.csv
!data/processed/routing_table_train_512.metadata.json
!data/processed/routing_table_validation_128.csv
!data/processed/routing_table_validation_128.metadata.json

# Ignore model artifacts by default, then allow the final lightweight router
/models/*
!models/utility_prediction_realtime.pkl
!models/neural_utility_router.pkl

# Ignore intermediate/debug result folders if recreated later
results/debug/
results/intermediate/
results/confusion_matrices/
results/plots/final_confusion_matrices/

# Notebook checkpoints
.ipynb_checkpoints/
